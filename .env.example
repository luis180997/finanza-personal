# =============================================================================
#  Copia este archivo a .env y ajusta lo que necesites.
#  Con Docker basta con dejarlo tal cual: todos los valores tienen un defecto.
# =============================================================================

# ---------- General ----------
# dev  = la documentacion interactiva de la API esta en /api/docs
# prod = apagada. Es lo UNICO que cambia esta variable. No activa ningun "modo
#        seguro": la aplicacion sigue sin login en ambos casos.
APP_ENV=dev

TIMEZONE=America/Lima
BASE_CURRENCY=PEN

# Puerto en el que veras la aplicacion:  http://localhost:8080
# Es la unica variable de puerto que tocas: el URI de OAuth se deriva de ella.
# Si la cambias, registra el nuevo URI en Google Cloud Console (ver abajo).
PUERTO_WEB=8080

# ============================================================================
#  LECTURA DEL CORREO  <-- ESTO ES LO UNICO IMPRESCINDIBLE PARA QUE FUNCIONE
# ============================================================================
#  Sin estas dos lineas la app NO lee ni un correo. Todo lo demas ya viene
#  configurado.
#
#  Como conseguir la contrasena de aplicacion (2 minutos):
#    1. https://myaccount.google.com/security
#       -> activa la "Verificacion en 2 pasos" (sin ella el paso 2 no aparece)
#    2. https://myaccount.google.com/apppasswords
#       -> crea una, ponle el nombre que quieras, copia las 16 letras
#    3. Pegala abajo (con o sin espacios, da igual) y:  docker compose up -d
#
#  Se revoca cuando quieras desde esa misma pagina de Google.
IMAP_USER=tucorreo@gmail.com
IMAP_PASSWORD=las16letrasdelacontrasenadeaplicacion

# imap  = contrasena de aplicacion (por defecto). No caduca.
# gmail = OAuth con secrets/credentials.json. Permiso de solo lectura, pero
#         mientras la app este en "Testing" en Google Cloud Console el token
#         caduca cada 7 dias y hay que volver a autorizar.
EMAIL_BACKEND=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Ponlo en false SOLO si tu antivirus o proxy intercepta TLS y la conexion
# falla por certificado. Apagarlo abre la puerta a un intermediario.
IMAP_VERIFICAR_CERTIFICADO=true

# Ventana por defecto al sincronizar (dias hacia atras)
GMAIL_LOOKBACK_DAYS=30
# Cada cuantos minutos lee el correo solo. 0 lo desactiva.
SYNC_INTERVAL_MINUTES=15
# Pasados estos dias se borra el TEXTO de los correos guardados (la ficha se
# conserva para no reprocesarlos). 0 = no borrar nunca.
EMAIL_RETENTION_DAYS=90

# ---------- Importar Excel ----------
# Apagado por defecto. Hasta el 31/08/2026 la fuente de verdad es el Excel (ya
# importado); desde setiembre lo son los correos y lo que registras a mano. Un Excel
# con filas de setiembre en adelante duplicaria esos gastos. Ponlo en true solo para
# importar a proposito, y vuelve a apagarlo.
IMPORTAR_EXCEL_HABILITADO=false

# ---------- Copias de seguridad ----------
# Cada cuantos dias como minimo se copia la base (0 = sin copias automaticas; la
# copia previa a cambios de la base al arrancar se hace igual). No es una hora
# fija: al arrancar y cada hora se mira la fecha del ultimo respaldo, asi que si el
# equipo estuvo apagado la copia sale en cuanto vuelve a encenderse.
RESPALDO_CADA_DIAS=7
# Cuantas de las copias mas recientes se guardan siempre (0 = no borrar ninguna).
# Ademas queda la ultima de cada uno de los ultimos 7 dias, 8 semanas y 12 meses, y
# nunca se borra sola una copia con claramente mas movimientos que la ultima.
RESPALDO_CONSERVAR=8
# Carpeta de las copias. Vacio = data/respaldos. Con el proyecto dentro de OneDrive
# no hace falta tocarla. Con Docker, otra carpeta tendria que montarse como volumen
# y pasarse tambien en docker-compose.yml, que no la reenvia al contenedor.
# RESPALDO_DIR=

# ---------- Solo para ejecutar SIN Docker ----------
# En Docker estos valores los pone docker-compose.yml y se ignoran de aqui.
# Una ruta SQLite relativa se toma desde la raiz del proyecto, no desde la carpeta
# en la que lances el proceso.
# DATABASE_URL=sqlite:///data/finanzas.db
# DATA_DIR=./data
# SECRETS_DIR=./secrets
# CORS_ORIGINS=http://localhost:5173
# OAUTH_REDIRECT_URI=http://localhost:5173/api/gmail/callback
# APP_BASE_URL=http://localhost:5173

